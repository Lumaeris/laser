FROM ghcr.io/zirconium-dev/zirconium:latest

COPY just /usr/share/zirconium/just/00-start.just

RUN --mount=type=tmpfs,dst=/tmp \
    git clone https://github.com/opentabletdriver/opentabletdriver --branch v0.6.7 --depth=1 /tmp/otd && \
    install -Dm0644 <(/tmp/otd/generate-rules.sh) /usr/lib/opentabletdriver-config/udev/rules.d/70-opentabletdriver.rules && \
    install -Dm0644 /tmp/otd/eng/bash/Generic/usr/lib/modprobe.d/99-opentabletdriver.conf -t /usr/lib/opentabletdriver-config/modprobe.d && \
    install -Dm0644 /tmp/otd/eng/bash/Generic/usr/lib/modules-load.d/opentabletdriver.conf -t /usr/lib/opentabletdriver-config/modules-load.d
